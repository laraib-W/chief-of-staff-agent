# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.
#
# See SECURITY.md §2 for the full credential inventory, storage rules,
# and rotation procedure. See README.md quickstart for how each token is
# obtained.

# Google OAuth 2.0 client (Gmail + Calendar, scopes: gmail.readonly, calendar.readonly).
# Create at https://console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Plane API token (GET-only usage).
# Generate at Plane → Settings → API Tokens.
#
# Used by `app/` on main. NOT used by experiment/claude-agent-sdk:
# that branch's Plane MCP server handles its own auth (hosted OAuth
# for cloud Plane; `claude mcp add --env` at install time for
# self-hosted). See docs/mcp-servers.md.
PLANE_API_TOKEN=

# LLM API keys. Set the one that matches `llm.provider` in config.yaml;
# the other can be left blank.

# Anthropic (llm.provider: anthropic). Generate at https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Google Gemini (llm.provider: gemini). Generate at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
