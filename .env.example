# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.
#
# See SECURITY.md §2 for the full credential inventory, storage rules,
# and rotation procedure. See README.md quickstart for how each token is
# obtained.

# Google OAuth 2.0 client — ONE Web-application client serves all three
# consumers: the gmail MCP, the gcal MCP, and the digest send path in
# app_sdk/auth.py. Create at https://console.cloud.google.com →
# APIs & Services → Credentials → Create Client → Web application.
#
# Register BOTH redirect URIs on it (exact match, "localhost" not "127.0.0.1"):
#   http://localhost:8765/callback   ← the MCP servers (claude mcp login)
#   http://localhost:8766/           ← the send path (app_sdk.auth --setup)
#
# Scopes on the consent screen: gmail.readonly, gmail.send, and the three
# calendar.*.readonly scopes. See docs/mcp-servers.md for the full setup.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Plane API token. Generate at Plane → Settings → API Tokens.
# Used by `app/` on main and by scripts/setup-mcps.sh on the SDK branch
# (passed to the plane MCP server as PLANE_API_KEY).
PLANE_API_TOKEN=

# Plane workspace slug — the short name in your Plane URL: <host>/<slug>/.
# SDK branch only (consumed by scripts/setup-mcps.sh).
PLANE_WORKSPACE_SLUG=

# Plane API host URL — base URL of your Plane instance.
# Cloud: https://api.plane.so   Self-hosted: e.g. https://projects.arbisoft.com
# SDK branch only (consumed by scripts/setup-mcps.sh).
PLANE_API_HOST_URL=

# LLM API keys. Set the one that matches `llm.provider` in config.yaml;
# the other can be left blank.

# Anthropic (llm.provider: anthropic). Generate at https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Google Gemini (llm.provider: gemini). Generate at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
