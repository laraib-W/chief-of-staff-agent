# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.
#
# See SECURITY.md §2 for the full credential inventory, storage rules,
# and rotation procedure. See README.md quickstart for how each token is
# obtained.

# Google OAuth 2.0 client (Gmail + Calendar; scopes: gmail.readonly, gmail.send,
# calendar.readonly). gmail.send is used only by render_and_deliver to email the
# digest to your own delivery_address. Create at
# https://console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Plane API token (GET-only usage).
# Generate at Plane → Settings → API Tokens.
PLANE_API_TOKEN=

# LLM API keys. Set the one that matches `llm.provider` in config.yaml;
# the other can be left blank.

# Anthropic (llm.provider: anthropic). Generate at https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Google Gemini (llm.provider: gemini). Generate at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Optional. Set to 1 if outbound API calls hang for ~60 s (Google/LLM APIs) on
# your network. Forces IPv4-only DNS resolution as a workaround for hosts where
# IPv6 is advertised but not routable (some VPNs, some home/corporate networks).
# See app/net_compat.py for details.
COS_FORCE_IPV4=
