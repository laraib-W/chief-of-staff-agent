# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.
#
# See SECURITY.md §2 for the full credential inventory, storage rules,
# and rotation procedure. See README.md quickstart for how each token is
# obtained.

# Google OAuth 2.0 client (Gmail + Calendar, scopes: gmail.readonly, calendar.readonly).
# Create at https://console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Plane API token (GET-only usage).
# Generate at Plane → Settings → API Tokens.
PLANE_API_TOKEN=

# Anthropic API key (LLM inference).
# Generate at https://console.anthropic.com.
ANTHROPIC_API_KEY=
