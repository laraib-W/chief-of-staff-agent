# Secrets and runtime state
.env
.env.local
*.db
*.db-journal

# Real user config (see config.example.yaml for the template)
config.yaml

# experiment/claude-agent-sdk: goals.yaml holds identity + Plane IDs.
# Commit only the template shape by keeping the placeholder version;
# never commit the filled-in file. The `!goals.yaml` line below is a
# manual carve-out: uncomment it when publishing the template.
goals.local.yaml

# Claude Code local state (session history, personal overrides) — but
# slash commands under .claude/commands/, subagents under .claude/agents/,
# and the shared permission rules in .claude/settings.json ship with the
# repo so `/morning-digest`, `/plane-standup`, etc. work out of the box
# after clone. settings.local.json stays ignored: it is per-machine.
.claude/*
!.claude/commands/
!.claude/agents/
!.claude/settings.json

# Private fixtures that cannot be safely committed
tests/fixtures/private/
tests/evaluation/golden_private/
tests/evaluation/results/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtualenv
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Build artifacts
build/
dist/

# Local cache for slash commands (Plane members, etc.)
.cache/
